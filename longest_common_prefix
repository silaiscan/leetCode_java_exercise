class Solution {
    public String longestCommonPrefix(String[] strs) {
        for (int i = 0; i < strs[0].length(); i++) { //dizideki ilk kelimenin uzunluğunu içeren bir for döngüsü yaptık

    char karakter = strs[0].charAt(i);// burada ilk kelimenin karakterlerini alıyoruz sırasıyla

    for (int j = 1; j < strs.length; j++) { //burada ise ilk kelimeyi pas geçip ikinci kelimeden başlıyoruz çünkü ilk kelimenin karakterleri ile diğerlerini karşılaştırıcaz aynı mı diye çünkü tüm kelimelerde ortak olanı arıyoruz

        if (i >= strs[j].length() || strs[j].charAt(i) != karakter) {//burada diyorki eğer i diğer kelimelerin uzunluğunu geçtiyse veya ilk kelime ile diğer kelimelerin karakterleri eşleşmiyorsa
            return strs[0].substring(0, i); //ilk kelimenin i.indekse kadar olan kısmını döndür(i dahil değil)
        }
    }
}

return strs[0];

    }
}
