class Solution { //bize verilen sayı 2nşn bir üslüsüyse,16 32 128 gibi true döndür değilse false döndür
    public boolean isPowerOfTwo(int n) {
        int i=0;
        if(n==1){
            return true;
        }
        else if(n%2==0){
        while(i<n){
            if(Math.pow(2,i)==n){
                return true;
            }
            i++;
        }
        }
        return false;
    }
}
